# Salin file ini menjadi .env di ROOT skill (sejajar dengan SKILL.md), lalu isi nilainya.
# 1) Buat Internal Integration di https://www.notion.so/my-integrations
#    -> Copy "Internal Integration Secret" ke NOTION_TOKEN
# 2) Buka database "Open Call Pipeline" -> menu ⋯ -> Connections -> tambahkan integration kamu
# 3) Ambil DATABASE ID dari URL database (32 karakter hex setelah nama, sebelum "?")

NOTION_TOKEN="secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NOTION_DATABASE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Apify — untuk Instagram scraper (instagram_scrape.py)
# Daftar gratis di https://apify.com (free tier: ~$5 kredit/bulan)
# Ambil token di https://console.apify.com/account/integrations
APIFY_TOKEN="apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
